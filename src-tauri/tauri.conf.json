{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Starroom",
  "version": "0.2.0",
  "identifier": "studio.starroom.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Starroom", "width": 1440, "height": 900, "minWidth": 920, "minHeight": 620 }],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../NOTICE.md": "NOTICE.md",
      "../MODEL_PROVENANCE.md": "MODEL_PROVENANCE.md",
      "../docs/17_THIRD_PARTY_PROVENANCE.md": "docs/17_THIRD_PARTY_PROVENANCE.md"
    }
  }
}
